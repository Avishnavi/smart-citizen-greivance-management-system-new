# Smart Citizen Grievance Backend - Environment Variables Template
# Copy this file to .env and fill in the values.
# NEVER commit the real .env file to GitHub.

# MongoDB Atlas Connection String
# Replace <db_username> and <db_password> with your MongoDB Atlas database credentials
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.rxpo0m9.mongodb.net/?appName=Cluster0
DATABASE_NAME=smart_grievance

# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:5173

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Node Environment: development | production
NODE_ENV=development
